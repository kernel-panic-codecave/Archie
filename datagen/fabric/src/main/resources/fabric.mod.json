{
  "schemaVersion": 1,
  "id": "${mod_id}_datagen",
  "version": "${mod_version}",
  "name": "${mod_display_name} Datagen",
  "description": "${mod_display_name}'s datagen DSL - dev-time only, never shipped in a production jar.",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_url}",
    "sources": "${mod_source}"
  },
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "net.kernelpanicsoft.archie.data.ArchieDatagenFabric"
      }
    ]
  },
  "mixins": [
    "${mod_id}_datagen.mixins.json"
  ],
  "depends": {
    "minecraft": "${versions.minecraft}",
    "fabricloader": ">=${versions.fabric_loader}",
    "fabric-api": ">=${versions.fabric_api}",
    "fabric-language-kotlin": ">=${versions.kotlin_fabric}",
    "archie": ">=${mod_version}"
  }
}
